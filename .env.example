# Copy to app.env (git-ignored):   cp .env.example app.env
# Read by the API (Viper) and by the Makefile, so keep plain KEY=value lines
# with no quotes, spaces, '$' or '#' inside values.

APP_ENV=development
PORT=4000
# Business time zone (IANA name), validated at startup. Storage, JSON and DB sessions are always UTC.
APP_TIMEZONE=Africa/Nairobi

# Development: your locally installed PostgreSQL. Create the role and database
# by hand first (README -> Development), then match the credentials here.
DATABASE_URL=postgres://zemi:zemi_dev_password@localhost:5432/zemi_fleet?sslmode=disable

# Integration and e2e tests ONLY (make dev/test/integration, dev/test/e2e). A separate database that those tests
# truncate freely; the tests refuse to run unless its name ends in _test. Never point this at your dev database.
# Create it like the dev one:  CREATE DATABASE zemi_fleet_test OWNER zemi;
TEST_DATABASE_URL=postgres://zemi:zemi_dev_password@localhost:5432/zemi_fleet_test?sslmode=disable

# Connection pool (Let's Go Further ch. 5.3)
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_TIME=15m
# Upper bound for every SQL statement (Let's Go Further ch. 8.3)
DB_QUERY_TIMEOUT=3s

# Rider's share of each delivery fee in basis points (9000 = 90%). Snapshotted on every order.
RIDER_PAYOUT_BPS=9000

# Orders (POST /orders): the shortest allowed pickup-to-delivery distance, in metres (shorter is a 422)
ORDER_MIN_TRIP_M=50

# Money bounds (KES, per request). Amounts are converted to int64 cents; these keep every sum far from overflow.
ORDER_MAX_VALUE_KES=10000000
ORDER_MAX_DELIVERY_FEE_KES=10000000

# Idempotency-Key on POST /orders and POST /orders/batch
# IDEMPOTENCY_TTL: how long a key is remembered (older keys are ignored and deleted on write)
# IDEMPOTENCY_PROCESSING_TIMEOUT: how long a claimed key may stay unfinished before a retry may take it over
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_PROCESSING_TIMEOUT=2m

# Proximity matching (POST /riders/match-orders)
# CONE_RADIUS_KM: max pickup distance from the rider (inclusive)
# CONE_HALF_ANGLE_DEG: half the cone's opening; 30 = the 60 degree cone
# CONE_MIN_SPEED_KMH: below this speed (or with no heading) the cone is skipped and the full circle is used
# CONE_MAX_RESULTS: cap on matching_orders
CONE_RADIUS_KM=1
CONE_HALF_ANGLE_DEG=30
CONE_MIN_SPEED_KMH=3
CONE_MAX_RESULTS=20

# Order batching (POST /orders/batch)
# BATCH_MAX_ORDERS: largest batch (1-5, the database CHECK allows 5)
# BATCH_PICKUP_RADIUS_KM: max distance between ANY two pickups in a batch (pairwise), and the largest radius_km a request may use
# BATCH_DIRECTION_TOLERANCE_DEG: max difference between a trip's bearing and the batch seed's
# BATCH_SEARCH_RADIUS_KM: how far from the rider pending orders / open batches are searched
# BATCH_VISIBILITY_RADIUS_KM: default radius_km of GET /batches (a request may use up to BATCH_SEARCH_RADIUS_KM)
# BATCH_TTL: how long an open batch is offered before it expires and its orders go back to pending
# AVG_SPEED_KMH, STOP_DWELL_MIN: delivery time estimates (driving speed; minutes spent at each earlier stop)
BATCH_MAX_ORDERS=5
BATCH_PICKUP_RADIUS_KM=2
BATCH_DIRECTION_TOLERANCE_DEG=45
BATCH_SEARCH_RADIUS_KM=5
BATCH_VISIBILITY_RADIUS_KM=3
BATCH_TTL=10m
AVG_SPEED_KMH=20
STOP_DWELL_MIN=2

# Rider preference matching (POST /orders/match-riders)
# MATCH_MAX_DISTANCE_KM: riders with a fresh location farther than this from the pickup are excluded; also where the proximity score hits 0
# RIDER_LOCATION_STALE_AFTER: an older location is "unknown" (not filtered, scores 0 for proximity)
# MATCH_WEIGHT_*: score weights (category, area, proximity, acceptance rate); they MUST sum to 1.0
# MATCH_MAX_RESULTS: cap on matching_riders
MATCH_MAX_DISTANCE_KM=10
RIDER_LOCATION_STALE_AFTER=30m
MATCH_WEIGHT_CATEGORY=0.25
MATCH_WEIGHT_AREA=0.20
MATCH_WEIGHT_PROXIMITY=0.35
MATCH_WEIGHT_ACCEPTANCE=0.20
MATCH_MAX_RESULTS=10

# Staging only: credentials for the Postgres container on Docker Desktop
# (docker-compose.yml). Separate from your local database.
DB_USER=zemi
DB_PASSWORD=zemi_staging_password
DB_NAME=zemi_fleet
STAGING_API_PORT=8080
STAGING_DB_PORT=5433
